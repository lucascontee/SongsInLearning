<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:vm="using:SongsInLearning.ViewModels"
			 x:DataType="vm:StudioViewModel"
			 x:Class="SongsInLearning.Views.StudioView"
			 Background="#1c1c1c">

	<StackPanel Spacing="15" Margin="20">
		<StackPanel Orientation="Horizontal" Spacing="20">
			<TextBlock Text="Estúdio de Prática"
					   FontSize="20"
					   FontWeight="Bold"
					   Foreground="#e8e8e8"
					   VerticalAlignment="Center"/>

			<Panel VerticalAlignment="Center">

				<Border Background="#2a0d0d"
						BorderBrush="#4a1515"
						BorderThickness="1"
						CornerRadius="6"
						Padding="12,4"
						IsVisible="{Binding !IsRecording}">
					<TextBlock Text="GRAVANDO"
							   Foreground="#5c1c1c"
							   FontWeight="Black"
							   FontSize="12"
							   LetterSpacing="2"/>
				</Border>

				<Border Background="#cc0000"
						BorderBrush="#ff3333"
						BorderThickness="1"
						CornerRadius="6"
						Padding="12,4"
						IsVisible="{Binding IsRecording}"
						BoxShadow="0 0 15 2 #cc0000">
					<TextBlock Text="GRAVANDO"
							   Foreground="White"
							   FontWeight="Black"
							   FontSize="12"
							   LetterSpacing="2"/>
				</Border>

			</Panel>
		</StackPanel>
		<StackPanel Spacing="5" Margin="0,5,0,10">
			<TextBlock Text="Interface de Entrada (Microfone/Instrumento):" Foreground="#a4b0be" FontSize="13"/>
			<ComboBox ItemsSource="{Binding AvailableInputDevices}"
					  SelectedIndex="{Binding SelectedDeviceIndex}"
					  Background="#2c2c2c"
					  BorderBrush="#4e4e4e"
					  HorizontalAlignment="Stretch"/>
		</StackPanel>

		<StackPanel Orientation="Horizontal" Spacing="15" Margin="0,5,0,10">
			<Button Command="{Binding ToggleRecordingCommand}"
					Background="Transparent"
					BorderBrush="#4e4e4e"
					Width="45" Height="45"
					CornerRadius="25">

				<Panel>
					<Path Data="{StaticResource RecRegular}"
						  Fill="#cc0000"
						  Stretch="Uniform"
						  Width="18"
						  Height="18"
						  IsVisible="{Binding !IsRecording}"/>

					<Path Data="{StaticResource StopRegular}"
						  Fill="#cc0000"
						  Stretch="Uniform"
						  Width="18"
						  Height="18"
						  IsVisible="{Binding IsRecording}"/>
				</Panel>
			</Button>
			<Button Command="{Binding TogglePlaybackCommand}"
					IsEnabled="{Binding !IsRecording}"
					Background="Transparent"
					BorderBrush="#4e4e4e"
					Width="45" Height="45"
					CornerRadius="25">
				<Panel>
					<Path Data="{StaticResource PlayCircleRegular}"
						  Fill="#00ab73"
						  Stretch="Uniform"
						  Width="18"
						  Height="18"
						  IsVisible="{Binding !IsPlaying}"/>

					<Path Data="{StaticResource StopRegular}"
						  Fill="#00ab73"
						  Stretch="Uniform"
						  Width="18"
						  Height="18"
						  IsVisible="{Binding IsPlaying}"/>
				</Panel>
			</Button>
		</StackPanel>

		<Border Background="#1c1c1c" BorderBrush="#4e4e4e" BorderThickness="1" CornerRadius="8" Height="90" Padding="10">
			<Grid ColumnDefinitions="120, *">
				<StackPanel VerticalAlignment="Center">
					<TextBlock Text="Track 1" Foreground="#e8e8e8" FontWeight="SemiBold"/>
					<TextBlock Text="Input 1" Foreground="#8e8e8e" FontSize="12"/>
				</StackPanel>

				<Border Grid.Column="1" Background="#2a2a2a" CornerRadius="4" Margin="10,0,0,0" ClipToBounds="True">

					<ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">

						<ItemsControl ItemsSource="{Binding WaveformPeaks}" Margin="5,0">

							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>

							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Rectangle Width="2"
											   Height="{Binding}"
											   Fill="#00ab73"
											   RadiusX="1"
											   RadiusY="1"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>

						</ItemsControl>

					</ScrollViewer>

				</Border>
			</Grid>
		</Border>
		<Border Background="#1c1c1c" BorderBrush="#4e4e4e" BorderThickness="1" CornerRadius="8" Height="90" Padding="10">
			<Grid ColumnDefinitions="120, *">
				<StackPanel VerticalAlignment="Center">
					<TextBlock Text="Track 2 (Wet)" Foreground="#e8e8e8" FontWeight="SemiBold"/>
					<TextBlock Text="AmpliTube 5" Foreground="#00ab73" FontSize="12"/>
				</StackPanel>

				<Border Grid.Column="1" Background="#2a2a2a" CornerRadius="4" Margin="10,0,0,0">
					<TextBlock Text="[ Área para retorno com efeitos / Backing track ]"
							   Foreground="#4e4e4e"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center"/>
				</Border>
			</Grid>
		</Border>

		<Button Background="Transparent"
				Padding="20,10"
				CornerRadius="5"
				BorderBrush="#4e4e4e"
				BorderThickness="1"
				HorizontalContentAlignment="Center"
				VerticalContentAlignment="Center">

			<StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
				<Path Data="{StaticResource WrenchRegular}"
					  VerticalAlignment="Center"
					  Fill="#00ab73"
					  Stretch="Uniform"
					  Width="22"
					  Height="16"/>
				<TextBlock Text="Plugins" VerticalAlignment="Center"/>
			</StackPanel>
		</Button>

	</StackPanel>
</UserControl>
