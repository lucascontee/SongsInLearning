<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:vm="clr-namespace:SongsInLearning.ViewModels"
             x:Class="SongsInLearning.Views.SideBarView"
		      x:DataType="vm:SideBarViewModel"
			 x:Name="SideBar">

		<UserControl.Styles>
		<StyleInclude Source="avares://SongsInLearning/Resources/Styles.axaml" />
	</UserControl.Styles>

	<Grid ColumnDefinitions="*">
		
		<StackPanel Background="#010f2a">
			<ScrollViewer VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
				<ContentPresenter x:Name="contentPresenter" />
			</ScrollViewer>

		</StackPanel>

	</Grid>
</UserControl>
