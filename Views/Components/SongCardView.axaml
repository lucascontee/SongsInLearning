<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:SongsInLearning.ViewModels"
             x:DataType="vm:SongCardViewModel"
             Background="Black"
             x:Class="SongsInLearning.Views.SongCardView">



  <Border Background="#2c2c2c" 
        BorderBrush="#00ab73" 
        BorderThickness="1" 
        CornerRadius="8" 
        Padding="16" 
        Margin="8"
        HorizontalAlignment="Stretch"
        Width="300"
        Height="160">
    
    <Grid ColumnDefinitions="*, Auto">
        
        <StackPanel Grid.Column="0" VerticalAlignment="Top">
            
            <TextBlock Text="Eruption" 
                       FontSize="18" 
                       FontWeight="SemiBold" 
                       Foreground="White"
                       TextTrimming="CharacterEllipsis" Margin="0, 0, 0, 5"/>
            
            <TextBlock Text="Van Halen" 
                       FontSize="14" 
                       Foreground="#a4b0be"
                       TextTrimming="CharacterEllipsis"
                       Margin="0, 0, 0, 0"/>
            
                
                <TextBlock Text="1978" 
                           FontSize="13" 
                           Foreground="#8395a7" 
                           VerticalAlignment="Center"
                           Margin="0, 0, 0, 10"/>

            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0, 0, 0, 5">
                    <TextBlock Text="Status:" 
                               FontSize="13" 
                               Foreground="#8395a7" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Em andamento" 
                               FontSize="13" 
                    FontWeight="Medium" 
                    Foreground="#a4b0be"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0, 0, 0, 5">
				<TextBlock Text="Instrumento:" 
                    FontSize="13" 
                    Foreground="#8395a7" 
                    VerticalAlignment="Center"/>

                <TextBlock Text="Guitarra" 
                    FontSize="13" 
                    FontWeight="Medium" 
                    Foreground="#a4b0be"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="5">		
                <TextBlock Text="Dificuldade:" 
                    FontSize="13" 
                    Foreground="#8395a7" 
                    VerticalAlignment="Center"/>
                <TextBlock Text="Difícil" 
                    FontSize="13" 
                    FontWeight="Medium" 
                    Foreground="#e05252"/>
            </StackPanel>

 
        </StackPanel>

        <Grid Grid.Column="1" Width="40" Height="40" Margin="16,0,0,0" VerticalAlignment="Top">
            
            <PathIcon Data="{StaticResource EletricGuitarRegular}" 
                      Width="26" Height="26" 
                      Foreground="#00ab73"/>
            
        </Grid>
        
    </Grid>
</Border>
</UserControl>
